table fct_generacion_hora
	lineageTag: bed52374-982e-482b-81db-654cdc13c537
	sourceLineageTag: [gold].[fct_generacion_hora]

	measure 'Generación GWh' = ```
			
			        DIVIDE ( SUM ( fct_generacion_hora[generacion_kwh] ), 1000000 )
			```
		formatString: #,0
		lineageTag: 5aab536f-75d6-4a69-ad32-783287213af3

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Participación generación' = ```
			
			        DIVIDE ( [Generación GWh], CALCULATE ( [Generación GWh], ALL ( dim_recurso ) ) )
			```
		formatString: 0.0%
		lineageTag: c50b9aa8-f6bf-4e6b-abc9-dd3eb7ce75e9

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Participación hidráulica' = ```
			
			        DIVIDE (
			            CALCULATE ( [Generación GWh], dim_recurso[tecnologia] = "Hidráulica" ),
			            CALCULATE ( [Generación GWh], ALL ( dim_recurso ) )
			        )
			```
		formatString: 0.0%
		lineageTag: fac25c88-1fd0-4fdc-a29e-c1033aa94fb8

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

